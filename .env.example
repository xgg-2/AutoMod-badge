# Required
DISCORD_TOKEN=
CLIENT_ID=

# Optional. Comma separated user IDs allowed to run /badge.
# Leave empty to use the application owner (or every member of the owning team).
OWNER_IDS=

# Optional tuning. The values below are the defaults.
# Rules created per server. Discord allows at most 6 keyword rules per server.
RULES_PER_GUILD=6
# Rules the bot must own for the badge.
TARGET_RULES=100
# Extra rules to aim for, as a percent of TARGET_RULES, in case a few fail.
SAFETY_MARGIN_PERCENT=10
# Pause between API calls, in milliseconds.
CREATE_DELAY_MS=1200
# Name given to created rules: "<prefix> <number>".
RULE_NAME_PREFIX=AutoMod
